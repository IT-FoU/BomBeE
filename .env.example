# BomBee Market — example environment (NO SECRETS)
# Copy to `.env` for local development.

APP_ENV=local
APP_NAME=BomBee Market
NODE_ENV=development
API_PORT=8787

PUBLIC_API_URL=http://localhost:8787
PUBLIC_CUSTOMER_URL=http://localhost:5173
PUBLIC_BACKOFFICE_URL=http://localhost:5174

# Optional until Milestone 1 (local Supabase / PGlite)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=local-anon-key-not-a-secret
# SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-not-a-secret
# Never copy Staging/Production keys into Local.

# Phase 1 hard rule — must stay false
EGO_POS_ENABLED=false

# Local defaults: invite-only off, mock integrations
# INVITE_ONLY_ENABLED=false
# INTEGRATIONS_MODE=mock

DISPLAY_TIMEZONE=Asia/Vientiane
CURRENCY_CODE=LAK
