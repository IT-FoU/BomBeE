# Production example — Owner approval required before use.
# Credentials live only in the Production secret store.
APP_ENV=production
NODE_ENV=production
API_PORT=8787
PUBLIC_API_URL=https://api.example.bombee
PUBLIC_CUSTOMER_URL=https://example.bombee
PUBLIC_BACKOFFICE_URL=https://backoffice.example.bombee
