# Production example — Owner approval required before use.
# Credentials live only in the Production secret store.
APP_ENV=production
NODE_ENV=production
API_PORT=8787
PUBLIC_API_URL=https://api.example.bombee
PUBLIC_CUSTOMER_URL=https://example.bombee
PUBLIC_BACKOFFICE_URL=https://backoffice.example.bombee
# SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT.supabase.co
# SUPABASE_ANON_KEY=<from production secret store>
# SUPABASE_SERVICE_ROLE_KEY=<from production secret store>
EGO_POS_ENABLED=false
# Production remains HOLD — live integrations blocked until written Owner order
INVITE_ONLY_ENABLED=true
INTEGRATIONS_MODE=sandbox
DISPLAY_TIMEZONE=Asia/Vientiane
CURRENCY_CODE=LAK
