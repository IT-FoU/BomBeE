# Staging example — use Staging project credentials from the secret store.
# Never commit real keys. Never reuse Production credentials here.
APP_ENV=staging
NODE_ENV=production
API_PORT=8787
PUBLIC_API_URL=https://api.staging.example.bombee
PUBLIC_CUSTOMER_URL=https://staging.example.bombee
PUBLIC_BACKOFFICE_URL=https://backoffice.staging.example.bombee
# SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
# SUPABASE_ANON_KEY=<from secret store>
# SUPABASE_SERVICE_ROLE_KEY=<from secret store>
EGO_POS_ENABLED=false
DISPLAY_TIMEZONE=Asia/Vientiane
CURRENCY_CODE=LAK
